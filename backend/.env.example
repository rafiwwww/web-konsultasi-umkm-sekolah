# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/konsultasi_umkm
# Set true bila pakai Neon / Supabase / Railway / RDS yang mewajibkan SSL
DATABASE_SSL=false

# ---- Auth ----
# Wajib minimal 32 karakter. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Origin frontend (Vite default 5173). Pisahkan dengan koma bila lebih dari satu.
FRONTEND_URL=http://localhost:5173

# ---- Upload ----
UPLOAD_DIR=uploads

# ---- Seed (hanya untuk development) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
SEED_ADMIN_EMAIL=admin@umkm.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_DEFAULT_PASSWORD=Password123!

# ---- Testing ----
# Matikan rate-limit login/registrasi HANYA saat menjalankan `npm run test:e2e`. Jangan aktifkan di production.
# DISABLE_RATE_LIMIT=true
